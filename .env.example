# Copia este archivo a .env y descomenta lo que quieras cambiar.
# Todas las variables son opcionales: sin .env, `npm start` usa los valores de abajo.

# PORT=4300
# BILLING_API_PORT=4310
# HOST=127.0.0.1

# "Hoy" del sandbox. Con 2026-10-13 valen los números de los criterios de aceptación.
# SANDBOX_TODAY=2026-10-13

# Carpeta de la base de Cobrix y de su clave de cifrado
# COBRIX_DATA_DIR=data

# Clave que cifra la contraseña del proveedor: 32 bytes en base64.
# Genera una con: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Sin ella, se crea data/cobrix.key la primera vez. Nunca la subas al repositorio.
# COBRIX_SECRET_KEY=

# Latencia simulada por pedido al administrador, para ver el progreso. 0 la desactiva.
# COBRIX_SIMULATED_LATENCY_MS=120

# Base de la API simulada del ISP (no se modifica)
# BILLING_API_DB=data/billing-api.sqlite
